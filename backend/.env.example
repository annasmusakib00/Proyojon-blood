NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=mysql://root:password@localhost:3306/proyojon

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=30d

# Firebase
FIREBASE_PROJECT_ID=proyojon-app
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@proyojon-app.iam.gserviceaccount.com

# SMS Gateway
SMS_GATEWAY_URL=https://api.btrac.com.bd/sms/send
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=PROYOJON

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Matching
SEARCH_RADIUS_KM=5
LOCK_DURATION_DAYS=120

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_MAX=5
